    {"id": 2, "type": "stat", "title": "Checks run", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 7}, "datasource": {"type": "prometheus", "uid": "-- Mixed --"}, "targets": [{"expr": "sentinelapi_checks_total", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Open incidents", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 7}, "datasource": {"type": "prometheus", "uid": "-- Mixed --"}, "targets": [{"expr": "sentinelapi_open_incidents", "refId": "A"}]},
    {"id": 4, "type": "table", "title": "Recent endpoint checks", "gridPos": {"x": 0, "y": 7, "w": 24, "h": 10}, "datasource": {"type": "postgres", "uid": "sentinel-postgres"}, "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT checked_at, monitor_id, outcome, http_status, latency_ms, error_type FROM results WHERE $__timeFilter(checked_at::timestamp) ORDER BY checked_at DESC LIMIT 100", "refId": "A"}]}
