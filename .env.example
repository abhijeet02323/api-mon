APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
DATABASE_PATH=./sentinelapi.db
CHECK_INTERVAL_MIN_SECONDS=60
CHECK_TIMEOUT_MAX_SECONDS=20
CHECKS_ENABLED=true
CORS_ORIGINS=http://localhost:8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary credentials; leave empty for IAM roles/default AWS credential chain.
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=amazon-bedrock-model-id:version
